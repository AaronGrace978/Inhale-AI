{
  "name": "inhale",
  "version": "1.0.0",
  "private": true,
  "description": "Inhale is a local-first desktop runtime that inhales behavioral markdown, strips foreign personas, mounts only the skill shards a turn needs, and can build files inside an open folder.",
  "main": "./out/main/index.js",
  "author": "Inhale",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@xyflow/react": "^12.12.1",
    "diff": "^9.0.0",
    "mdast": "^2.3.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "local.inhale.runtime",
    "productName": "Inhale",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
